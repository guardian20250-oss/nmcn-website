{
  "installCommand": "npm install --include-scripts",
  "buildCommand": "prisma generate && prisma db push --accept-data-loss && tsx prisma/seed.ts && tsx prisma/seed-academy.ts && next build",
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ]
}
