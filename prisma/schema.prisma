generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  name               String
  role               String   @default("admin")
  mustChangePassword Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdCreators    CreatorAccount[]
  handledTickets     SupportTicket[]
  statsSnapshots     CreatorStatSnapshot[]
  statsManagerOf     CreatorStatManagerAssignment[] @relation("StatsManager")
  statsTeamLeadOf    CreatorStatManagerAssignment[] @relation("StatsTeamLead")
  statsEmailMappings CreatorStatEmailMapping[]

  @@map("admins")
}

model Creator {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  password     String
  name         String
  tiktokHandle String?  @db.VarChar(100)
  createdById  Int?
  creatorAccounts CreatorAccount[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model SupportTicket {
  id          Int      @id @default(autoincrement())
  subject     String
  message     String
  category    String   @default("account")
  status      String   @default("open")
  email       String
  name        String?
  phone       String?
  accessToken String?
  userId      Int?
  userRole    String?
  handledById Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        CreatorAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)
  handledBy   Admin?          @relation(fields: [handledById], references: [id], onDelete: SetNull)
  replies     SupportTicketReply[]

  @@index([status])
  @@index([createdAt])
}

model SupportTicketReply {
  id         Int           @id @default(autoincrement())
  ticketId   Int
  authorType String
  authorId   Int?
  authorName String
  message    String
  createdAt  DateTime      @default(now())
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model SupportSettings {
  id                Int      @id @default(autoincrement())
  discordWebhookUrl String   @default("")
  notifyPhone       String   @default("")
  notifyCarrier     String   @default("")
  notifyEmail       String   @default("nexusmafiacreatornetworkllc@outlook.com")
  updatedAt         DateTime @updatedAt

  @@map("support_settings")
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("site_settings")
}

model CreatorAccount {
  id                 Int      @id @default(autoincrement())
  email              String   @unique
  password           String
  name               String
  tiktokHandle       String?  @db.VarChar(100)
  status             String   @default("pending")
  assignedRole       String   @default("creator")
  independentCreator Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  createdById        Int?
  createdBy          Admin?   @relation(fields: [createdById], references: [id])
  creators           Creator[]
  progress           CreatorProgress[]
  certificates       Certificate[]
  quizAttempts       QuizAttempt[]
  supportTickets     SupportTicket[]
  creatorStats       CreatorStat[]
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

model Course {
  id           Int       @id @default(autoincrement())
  title        String
  slug         String    @unique
  description  String    @default("")
  icon         String    @default("GraduationCap")
  passingScore Int       @default(70)
  order        Int       @default(0)
  status       String    @default("draft")
  role         String    @default("creator")
  allowedRoles String[]  @default([])
  lessons      Lesson[]
  certificates Certificate[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
}

model Lesson {
  id       Int           @id @default(autoincrement())
  courseId Int
  course   Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title    String
  slug     String
  summary  String?       @db.Text
  sections Json          @default("[]")
  order    Int           @default(0)
  status   String        @default("draft")
  questions Question[]
  progress  CreatorProgress[]
  attempts  QuizAttempt[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@unique([courseId, slug])
}

model Question {
  id          Int     @id @default(autoincrement())
  lessonId    Int
  lesson      Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  prompt      String
  type        String  @default("multiple_choice")
  options     Json    @default("[]")
  correctIndex Int
  explanation String? @db.Text
  order       Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model CreatorProgress {
  id          Int           @id @default(autoincrement())
  creatorId   Int
  creator     CreatorAccount @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  lessonId    Int
  lesson      Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  bestScore   Int           @default(0)
  passed      Boolean       @default(false)
  attempts    Int           @default(0)
  completedAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt

  @@unique([creatorId, lessonId])
}

model QuizAttempt {
  id         Int      @id @default(autoincrement())
  creatorId  Int?
  creator    CreatorAccount? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  lessonId   Int
  lesson     Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  score      Int
  passed     Boolean
  answers    Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model Certificate {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  learnerName  String
  creatorId    Int?
  creator      CreatorAccount? @relation(fields: [creatorId], references: [id], onDelete: SetNull)
  courseId     Int
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  completedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now()) @updatedAt
}

model JoinApplication {
  id               Int      @id @default(autoincrement())
  tiktokHandle     String
  discordHandle    String
  email            String
  followerCount    String?
  avgLiveViewers   String?
  agencyExperience String?
  status           String   @default("pending")
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  quote     String
  rating    Int      @default(5)
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  replied   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ---- Creator Stats (TikTok LIVE Backstage export imports) ----
// Each upload of the Backstage "Manage creators" export = one snapshot record.
// Owners import every row; team leads / managers import only rows in their
// scope (out-of-scope rows are never stored). Rows merge per creator by
// (Creator ID, export date), so overlapping uploads never duplicate data.

model CreatorStatSnapshot {
  id                Int           @id @default(autoincrement())
  exportedAt        DateTime
  periodType        String        @default("weekly") // weekly | monthly (end of month)
  originalFilename  String
  uploaderRole      String?
  rowCount          Int           @default(0) // rows imported
  matchedCount      Int           @default(0) // imported rows linked to a creator account
  skippedOutOfScope Int           @default(0)
  duplicateCount    Int           @default(0) // already on file for that export date
  unmatchedCount    Int           @default(0) // imported rows with no creator account
  uploadedById      Int?
  uploadedBy        Admin?        @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  stats             CreatorStat[]
  createdAt         DateTime      @default(now())

  @@index([exportedAt])
  @@map("creator_stat_snapshots")
}

model CreatorStat {
  id                       Int                 @id @default(autoincrement())
  snapshotId               Int
  snapshot                 CreatorStatSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  creatorAccountId         Int?
  creatorAccount           CreatorAccount?     @relation(fields: [creatorAccountId], references: [id], onDelete: SetNull)
  exportedAt               DateTime // copied from the snapshot for per-creator merging
  periodType               String              @default("weekly")
  backstageCreatorId       String              @db.VarChar(40)
  username                 String              @db.VarChar(100)
  groupName                String?
  teamLead                 String? // "Creator Network manager" column = team lead's email
  graduationStatus         String?
  tierStatus               String?
  tierLastMonth            Int?
  relationshipStatus       String?
  subscriptionStatus       String?
  joinTime                 DateTime?
  daysSinceJoining         Int?
  invitationType           String?
  invitedBy                String? // ADMIN-ONLY: never expose to creators
  promotePermission        String?
  lastLive                 DateTime?
  notes                    String?             @db.Text // ADMIN-ONLY: never expose to creators
  followers                Int                 @default(0)
  videos                   Int                 @default(0)
  likes                    BigInt              @default(0)
  diamondsL30D             Int                 @default(0)
  validDaysL30D            Int                 @default(0)
  liveDurationL30D         Float               @default(0) // hours
  fanClubDiamondsL30D      Int                 @default(0)
  fanClubActiveFansL30D    Int                 @default(0)
  managementDates          String?
  renewedManagementDates   String?
  achievedStarCreator      Boolean             @default(false)
  starCreatorDaysThisMonth Int                 @default(0)
  createdAt                DateTime            @default(now())

  @@unique([backstageCreatorId, exportedAt])
  @@index([creatorAccountId, exportedAt])
  @@index([snapshotId])
  @@index([username])
  @@index([teamLead])
  @@map("creator_stats")
}

model CreatorStatAuditLog {
  id         Int      @id @default(autoincrement())
  action     String // preview | import | delete | manager_assign | manager_unassign
  adminId    Int?
  adminEmail String
  snapshotId Int?
  details    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@map("creator_stat_audit_logs")
}

// Managers are not identified in the Backstage export, so an admin (owner)
// assigns each manager either team leads (manager sees all creators whose
// "Creator Network manager" column = that team lead's email) or specific
// creators by Backstage Creator ID.
model CreatorStatManagerAssignment {
  id                 Int      @id @default(autoincrement())
  managerId          Int
  manager            Admin    @relation("StatsManager", fields: [managerId], references: [id], onDelete: Cascade)
  teamLeadId         Int?
  teamLead           Admin?   @relation("StatsTeamLead", fields: [teamLeadId], references: [id], onDelete: Cascade)
  backstageCreatorId String?  @db.VarChar(40)
  createdAt          DateTime @default(now())

  @@unique([managerId, teamLeadId])
  @@unique([managerId, backstageCreatorId])
  @@index([managerId])
  @@map("creator_stat_manager_assignments")
}

// Backstage stores its own "Creator Network manager" email, which is frequently
// DIFFERENT from the email that staff member used to sign up on this site. That
// mismatch is why an owner sees "no team lead account with that email". An owner
// maps the Backstage value onto the real staff account, and that person's creators
// resolve to them automatically.
//
// Additive only: mappings extend the original email rule, they never replace it,
// so a team lead still sees creators listed under their own email as before.
model CreatorStatEmailMapping {
  id             Int     @id @default(autoincrement())
  backstageEmail String  @db.VarChar(254) // exact value from the Backstage column
  adminId        Int // the staff account on this site
  admin          Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  @@unique([backstageEmail])
  @@index([adminId])
  @@map("creator_stat_email_mappings")
}

// Creators removed from the stats pages (left the agency). Additive flag table:
// no stats rows are deleted — the profile is simply filtered out of every
// stats view, quick search, the creator's own My Stats page, AND future
// imports skip it, so a re-upload never brings them back. Owner can restore.
model CreatorStatHidden {
  id                 Int      @id @default(autoincrement())
  backstageCreatorId String   @unique @db.VarChar(40)
  hiddenBy           Int? // staff account that removed them
  hiddenAt           DateTime @default(now())

  @@map("creator_stat_hidden")
}
